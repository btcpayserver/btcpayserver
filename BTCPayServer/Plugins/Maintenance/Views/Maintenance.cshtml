@model MaintenanceViewModel
@{
    ViewData.SetLayoutModel(new LayoutModel(nameof(MaintenancePlugin), StringLocalizer["Maintenance"])
        .SetCategory(WellKnownCategories.Server));
}

<div class="sticky-header">
    <div class="d-flex flex-column gap-1">
        <h2 class="mb-0">@ViewData["Title"]</h2>
        <p class="text-secondary mb-0" text-translate="true">Change your server domain, restart services, clean up Docker images, and update BTCPay Server.</p>
    </div>
</div>
<partial name="_StatusMessage" />

<div class="row mb-5">
    <div class="col-xl-8 col-xxl-constrain">
        <component type="typeof(MaintenanceCommands)"
                   render-mode="ServerPrerendered"
                   param-CurrentDomain="@Model.DNSDomain"
                   param-BaseUrl="@Context.Request.GetRequestBaseUrl().ToString()" />
    </div>
</div>

@section PageHeadContent {
    <style>
        .maintenance-commands__log {
            min-height: 16rem;
            max-height: 50vh;
            overflow: auto;
            white-space: pre-wrap;
            overflow-wrap: anywhere;
        }
    </style>
}

@section PageFootContent {
    <script>
        window.btcpayMaintenance = {
            resetLog(element, emptyText) {
                element.textContent = emptyText;
                element.dataset.empty = 'true';
            },
            appendLog(element, text) {
                if (element.dataset.empty === 'true') {
                    element.textContent = '';
                    element.dataset.empty = 'false';
                }
                element.append(document.createTextNode(text));
                element.scrollTop = element.scrollHeight;
            }
        };
    </script>
}

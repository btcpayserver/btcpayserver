@model BTCPayServer.Models.ViewPullPaymentModel

@if (Model.LnurlEndpoint is not null)
{
    <p id="BoltcardActions" class="boltcard-actions">
        <a id="SetupBoltcard" class="boltcard-actions__setup" href="@Model.SetupDeepLink" target="_blank" rel="noreferrer noopener" text-translate="true">
            Setup Boltcard
        </a>
        <span>&nbsp;|&nbsp;</span>
        <a id="ResetBoltcard" class="boltcard-actions__reset" href="@Model.ResetDeepLink" target="_blank" rel="noreferrer noopener" text-translate="true">
            Reset Boltcard
        </a>
    </p>
}
